{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "righouse-data-faucet",
  "main": "src/index.js",
  "compatibility_date": "2024-09-23",

  // Fires the generator on a schedule, forever, independent of any browser
  // tab or session. */15 * * * * = every 15 minutes -- picked 2026-08-16 to
  // keep monthly Make operations (~7.8k est.) comfortably under the
  // Core/Pro/Teams base 10,000-op package; see PROJECT-STATUS.md. Change
  // freely, just re-check that math if you speed it back up.
  "triggers": {
    "crons": ["*/15 * * * *"]
  },

  // Internal state store: tracks which leads have already "converted" to an
  // order so the funnel logic doesn't double-convert the same lead.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "righouse-faucet",
      "database_id": "2e6bb891-8182-4259-ac37-f5b48b37dd7f"
    }
  ],

  "vars": {
    "BUSINESS_NAME": "RigHouse AV & Lighting"
  }

  // Once deployed, either:
  //   a) use Cloudflare Dashboard -> Workers & Pages -> your worker ->
  //      Settings -> Domains & Routes -> Add Custom Domain (e.g.
  //      events.j2analytics.ai) -- easiest, no config needed here, or
  //   b) uncomment and fill in a routes block:
  // "routes": [
  //   { "pattern": "events.j2analytics.ai/*", "zone_name": "j2analytics.ai" }
  // ]
}
