{
  "name": "righouse-data-faucet",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A fake pro AV/lighting retailer (leads + orders) for demoing Make and Zapier automations. Runs on Cloudflare Workers + D1.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "db:create": "wrangler d1 create righouse-faucet",
    "db:migrate:local": "wrangler d1 execute righouse-faucet --local --file=./migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute righouse-faucet --remote --file=./migrations/0001_init.sql",
    "secrets:make": "wrangler secret put MAKE_WEBHOOK_URL",
    "secrets:zapier": "wrangler secret put ZAPIER_WEBHOOK_URL",
    "secrets:shared": "wrangler secret put WEBHOOK_SHARED_SECRET",
    "secrets:zapier-storage": "wrangler secret put ZAPIER_STORAGE_SECRET",
    "test": "node --test"
  },
  "devDependencies": {
    "wrangler": "^4.120.1"
  }
}
