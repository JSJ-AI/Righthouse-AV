{
  "name": "j2analytics-data-faucet",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A fake-business data faucet (leads + orders) for demoing Make and Zapier automations. Runs on Cloudflare Workers + D1.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "db:create": "wrangler d1 create j2analytics-faucet",
    "db:migrate:local": "wrangler d1 execute j2analytics-faucet --local --file=./migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute j2analytics-faucet --remote --file=./migrations/0001_init.sql",
    "secrets:make": "wrangler secret put MAKE_WEBHOOK_URL",
    "secrets:zapier": "wrangler secret put ZAPIER_WEBHOOK_URL",
    "secrets:shared": "wrangler secret put WEBHOOK_SHARED_SECRET",
    "test": "node test/data.test.js"
  },
  "devDependencies": {
    "wrangler": "^4.120.1"
  }
}
